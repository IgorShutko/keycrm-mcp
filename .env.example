# Конфигурация KeyCRM MCP server.
# Скопируйте в .env и заполните.

# Поддомен аккаунта: your-account для your-account.keycrm.app
KEYCRM_DOMAIN=

# Логин и пароль владельца аккаунта (используются для внутреннего API).
KEYCRM_EMAIL=
KEYCRM_PASSWORD=

# Официальный OpenAPI-ключ (openapi.keycrm.app/v1).
# Необязательно: если пусто, сервер сам достанет ключ из настроек аккаунта.
KEYCRM_API_TOKEN=
